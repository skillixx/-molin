# ============================================================
# 预付/扣积分（prepaid）示例应用 —— 环境变量
# 复制为 .env 后填入平台方提供的认证信息再启动。
# ============================================================

# 平台 API 根地址。
# 同机部署务必用 127.0.0.1（IPv4 字面量），不要用 localhost（可能解析为 IPv6 ::1 被白名单误拒）。
PLATFORM_BASE_URL=http://127.0.0.1:8080

# 【平台方下发】内部接口共享密钥。调用 /api/internal/* 的 X-Internal-Token。
# 高敏感凭证，只放服务端环境变量，绝不写进前端 / 日志 / 代码仓库。
INTERNAL_API_TOKEN=替换为平台方给你的内部密钥

# 一次"生成"动作预占的积分上限（reserve 预估额）。实际消耗在 settle 时多退少补。
RESERVE_ESTIMATE=10

# 本应用自用：签名 Cookie 的密钥，随便生成一串随机值即可（与平台无关）。
SESSION_SECRET=change-me-to-a-random-string
