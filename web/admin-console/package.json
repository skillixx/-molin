{
  "name": "molin-admin-console",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "dev": "vite --host 0.0.0.0 --port 5173",
    "build": "vite build",
    "test:admin-verification": "node --test tests/admin-verification-contract.test.mjs",
    "test:email-management": "node --test tests/email-management-contract.test.mjs",
    "test:sms-management": "node --disable-warning=MODULE_TYPELESS_PACKAGE_JSON --experimental-strip-types --test tests/sms-management-contract.test.mjs",
    "test:vite-isolation": "node --test tests/vite-proxy-isolation.test.mjs",
    "test:outbound-url": "node --disable-warning=MODULE_TYPELESS_PACKAGE_JSON --experimental-strip-types --test tests/outbound-url.test.mjs",
    "test:g5-e2e": "playwright test tests/g5-workbench.spec.ts",
    "preview": "vite preview --host 0.0.0.0 --port 4173",
    "type-check": "vue-tsc --noEmit",
    "lint": "eslint ."
  },
  "dependencies": {
    "@element-plus/icons-vue": "^2.3.2",
    "@vitejs/plugin-vue": "^5.0.0",
    "axios": "^1.17.0",
    "element-plus": "^2.7.0",
    "pinia": "^2.1.0",
    "vite": "^5.0.0",
    "vue": "^3.4.0",
    "vue-router": "^4.3.0"
  },
  "devDependencies": {
    "@playwright/test": "^1.54.0",
    "@types/node": "^20.0.0",
    "@vue/eslint-config-typescript": "^14.6.0",
    "eslint": "^9.11.0",
    "eslint-plugin-vue": "^9.28.0",
    "typescript": "^5.4.0",
    "unplugin-auto-import": "^21.0.0",
    "unplugin-vue-components": "^32.1.0",
    "vue-tsc": "^2.1.0"
  }
}
