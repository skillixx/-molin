# ============================================================
# Molin 云管理平台 — 环境变量模板
# 复制此文件为 .env.local 并填写实际值
# 禁止将含真实密钥的 .env.local / .env.prod 提交到代码仓库
# ============================================================

# 应用基础
APP_ENV=local                          # local / test / production
APP_NAME=molin-cloud-platform
API_HOST=0.0.0.0
API_PORT=8080

# MySQL
MYSQL_HOST=127.0.0.1
MYSQL_PORT=13306
MYSQL_DATABASE=molin
MYSQL_USER=molin
MYSQL_PASSWORD=molin_password          # 生产环境必须更换为强密码

# Redis
REDIS_ADDR=127.0.0.1:16379
REDIS_PASSWORD=                        # 本地可为空，生产必须设置密码
REDIS_DB=0

# RabbitMQ
RABBITMQ_URL=amqp://molin:molin_password@127.0.0.1:5673/
AI_OUTBOX_EXCHANGE=molin.ai.billing

# MinIO
MINIO_ENDPOINT=127.0.0.1:19000
MINIO_ACCESS_KEY=molin
MINIO_SECRET_KEY=molin_password        # 生产环境必须更换
MINIO_BUCKET=molin
MINIO_USE_SSL=false                    # 生产环境改为 true

# JWT（必须使用随机生成的强密钥，不得使用示例值）
JWT_SECRET=REPLACE_WITH_RANDOM_SECRET_MIN_32_CHARS
JWT_EXPIRE_SECONDS=7200                # Access Token 有效期 2 小时

# Refresh Token（必须独立密钥，不得与 JWT_SECRET 相同）
REFRESH_TOKEN_SECRET=REPLACE_WITH_ANOTHER_RANDOM_SECRET
REFRESH_TOKEN_EXPIRE_DAYS=30

# 平台 sk（API Key）HMAC 存储密钥（与 REFRESH_TOKEN_SECRET 同级）
# DB 只存 HMAC-SHA256(sk, API_KEY_HMAC_SECRET)，不存明文；生产环境必须使用强随机值（如 openssl rand -hex 32）
# 注意：仅当此变量非空时后端才会装配 sk 系统（/api/keys 路由、sk 双模式鉴权）
API_KEY_HMAC_SECRET=REPLACE_WITH_API_KEY_HMAC_SECRET_MIN_32_CHARS

# 身份证号 HMAC（严禁使用 SHA256 直接 hash，必须使用 HMAC + 此密钥）
ID_CARD_HMAC_SECRET=REPLACE_WITH_HMAC_SECRET_MIN_32_CHARS

# 管理员双重认证有效期（小时），超时后需重新完成手机+邮箱认证，默认 24 小时
ADMIN_VERIFY_EXPIRE_HOURS=24

# Token 供应商密钥加密（第三阶段使用，AES-256-GCM 密钥必须 32 字节）
TOKEN_PROVIDER_KEY=REPLACE_WITH_32_BYTE_AES_KEY_FOR_PRODUCTION

# Token 文字模型执行层默认保留原生 Go 转发器；测试确认后才显式切换为 bifrost
TOKEN_EXECUTION_DRIVER=native
BIFROST_BASE_URL=http://127.0.0.1:18080
BIFROST_INTERNAL_TOKEN=REPLACE_WITH_SECURE_INTERNAL_TOKEN
# 渠道健康探测允许访问的受控内网主机或 host:port，默认空表示内网全拒。
AI_GATEWAY_HEALTH_INTERNAL_ALLOWLIST=
# 生产文字模型商业流量总闸。生产默认 false，只有发布门禁、授权和回滚点齐备后才可改为 true。
AI_GATEWAY_TRAFFIC_ENABLED=false
# G8 生产形态只接受固定 digest；示例值仅说明格式，部署前必须替换为审批清单中的真实摘要。
BIFROST_IMAGE_DIGEST=vendor/bifrost@sha256:REPLACE_WITH_APPROVED_DIGEST
AI_GATEWAY_ALERT_RELAY_IMAGE_DIGEST=internal/alert-relay@sha256:REPLACE_WITH_APPROVED_DIGEST
AI_GATEWAY_INTERNAL_TOKEN_FILE=/run/secrets/molin-ai-gateway-internal-token
AI_GATEWAY_ALERT_RELAY_CONFIG_FILE=/run/secrets/molin-ai-gateway-alert-relay-config

# 支付回调（第三阶段使用）
WECHAT_PAY_MCH_ID=                    # 微信支付商户号
WECHAT_PAY_API_V3_KEY=               # 微信支付 APIv3 密钥
WECHAT_PAY_SERIAL_NO=                # 微信支付证书序列号
# 微信支付平台公钥（PEM 文本），用于支付回调验签；生产/测试需注入真实值，不入库
WECHAT_PLATFORM_PUBLIC_KEY=
ALIPAY_APP_ID=                        # 支付宝 APPID
ALIPAY_PRIVATE_KEY=                   # 支付宝应用私钥
ALIPAY_PUBLIC_KEY=                    # 支付宝公钥

# 支付回调报文 AES-256-GCM 加密密钥（32 字节原始字符串），用于 payment_callbacks.notify_body
# 生产/测试需注入真实 32 字节随机值（如 openssl rand -hex 16），不入库
NOTIFY_BODY_KEY=REPLACE_WITH_32_BYTE_NOTIFY_BODY_KEY

# ============================================================
# 阿里云短信服务（首期仅支持中国大陆验证码短信）
# ============================================================
# 安全默认值为关闭。启用后如供应商、凭证、签名、手机号 HMAC 密钥或数据库场景绑定缺失，
# 后端必须 fail-closed：拒绝短信提交，且生产环境不得回退到模拟发送、固定验证码或接口返回明文验证码。
SMS_ENABLED=false
SMS_PROVIDER=aliyun

# 使用最小权限 RAM 用户或 RAM 角色凭证，通过 .env.local、服务器环境变量或 Secret Manager 注入。
# 禁止使用阿里云主账号长期 AccessKey，禁止把真实值写入本模板、Dockerfile、镜像、日志或数据库。
SMS_ALIYUN_ACCESS_KEY_ID=
SMS_ALIYUN_ACCESS_KEY_SECRET=

# 首期固定使用一个已审核通过的签名。数据库绑定仅保存提交快照，运行时必须与此固定签名一致。
SMS_ALIYUN_SIGN_NAME=

# 仅填写阿里云短信 API 域名，不带协议、路径或端口；网络侧按域名放行 TCP 443，不固定解析 IP。
SMS_ALIYUN_ENDPOINT=dysmsapi.aliyuncs.com

# 手机号 HMAC 独立密钥：用于发送日志限流和排障索引，不得与 AccessKey、JWT 或其他 HMAC 密钥复用。
# 生产和测试环境必须分别注入至少 32 字节的强随机值；轮换前需评估历史手机号 HMAC 查询连续性。
SMS_PHONE_HMAC_SECRET=REPLACE_WITH_SMS_PHONE_HMAC_SECRET_MIN_32_CHARS

# 测试模式仍调用真实阿里云，不是模拟发送。true 时所有短信只允许提交到下方白名单；
# 白名单为空必须全拒。生产部署必须先保持 true+SMS_ENABLED=false，完成白名单 Canary、监控和产品批准后，
# 才能在独立变更窗口改为 false；管理端“测试发送”仍始终受该白名单约束。
SMS_TEST_MODE=true
# 逗号分隔的中国大陆 11 位手机号；真实号码只写入不入库的 .env.local/.env.test/.env.prod。
SMS_TEST_PHONE_WHITELIST=
# 测试模式下允许进入真实供应商链路的固定场景；长期验证码登录仅填写 login。
# 测试模式启用短信时该项不能为空，未知或重复场景会导致 API 启动失败。
SMS_TEST_SCENE_ALLOWLIST=

# 五个场景的模板编码不再使用环境变量维护。
# register/login/reset_password/bind_phone/admin_verify 均以阿里云同步快照和数据库场景绑定为唯一权威。

# 阿里云 DirectMail 邮件模板与验证码发送（Phase 2）
# AccessKey 仅通过部署环境或 Secret Manager 安全注入，模板文件中必须保持为空，且不得输出到日志或接口响应
DIRECTMAIL_ACCESS_KEY_ID=
DIRECTMAIL_ACCESS_KEY_SECRET=
# DirectMail 服务地域固定为杭州；当前代码实际读取该变量，生产部署需保持 cn-hangzhou
DIRECTMAIL_REGION=cn-hangzhou
# 发信地址必须是在 DirectMail 控制台配置并验证通过的地址，由部署环境安全注入；模板中不得填写完整邮箱
DIRECTMAIL_ACCOUNT_NAME=
# 发件人别名由部署环境安全注入且不得为空；不得在前端提供编辑入口
DIRECTMAIL_FROM_ALIAS=
# DirectMail 官方服务域名为 dm.aliyuncs.com；必须使用 HTTPS 完整地址
DIRECTMAIL_ENDPOINT=https://dm.aliyuncs.com/
# 可选值为 production / mock；生产环境必须为 production，禁止启用 Mock
EMAIL_ADAPTER=production
# 邮箱地址 HMAC 密钥：使用独立强随机值，仅由部署环境注入，不得与其他 HMAC 或幂等密钥复用
EMAIL_ADDRESS_HMAC_SECRET=
# 邮件幂等 HMAC 密钥：使用独立强随机值，仅由部署环境注入，不得与邮箱地址 HMAC 密钥复用
EMAIL_IDEMPOTENCY_SECRET=
# 仅显式非生产环境可按需开启；生产环境必须为 false，禁止在响应中调试回传验证码
EMAIL_DEBUG_RETURN_CODE=false

# admin_verify 一次性首次配置入口：默认必须关闭；仅允许字面 true/false，显式空值会使应用启动失败
EMAIL_ADMIN_VERIFY_BOOTSTRAP_ENABLED=false
# 独立 Bootstrap Token：默认留空；仅在获批维护窗口通过 Secret 管理渠道注入，禁止复用其他 Token
EMAIL_ADMIN_VERIFY_BOOTSTRAP_TOKEN=
# 获批调用来源：默认留空；启用时填写逗号分隔的精确 IP/CIDR，禁止使用全网段占位
EMAIL_ADMIN_VERIFY_BOOTSTRAP_ALLOWED_IPS=
# 专用可信代理：默认留空；启用时填写实际代理的精确 IP/CIDR，不得复用公开或 metrics 配置
EMAIL_ADMIN_VERIFY_BOOTSTRAP_TRUSTED_PROXY_IPS=

# SMTP 邮件服务（预留，当前 DirectMail Phase 2 代码不读取）
SMTP_HOST=
SMTP_PORT=465
SMTP_USER=
SMTP_PASSWORD=
SMTP_FROM=noreply@example.com

# 公开流量可信反向代理：为空是合法直连模式，此时邮件/手机发码及密码重置只使用 RemoteAddr。
# 若管理/用户 Nginx 通过容器或独立代理连接 API，必须填写其专用固定 IP/CIDR；不得使用漂移单 IP、全部 Docker 网段或全网段占位。
# 非空时只接受逗号分隔的精确 IP 或 CIDR；每项 trim 后严格解析，拒绝空项、非法项和 IPv6 zone
# 配置非法时应用必须启动失败或 ready 不通过；不得回退使用 INTERNAL_TRUSTED_PROXY_IPS
# Nginx 必须覆盖 X-Real-IP=$remote_addr，并删除 X-Forwarded-For/Forwarded；应用永不使用 XFF 做安全判定
TRUSTED_PROXY_IPS=

# 内部接口来源白名单：逗号分隔的精确 IP 或 CIDR；每项 trim 后解析，空列表、空项或非法项使 metrics 失败关闭
# 非可信代理/直连只按 RemoteAddr 匹配本列表；指标端点还必须同时校验 INTERNAL_API_TOKEN
INTERNAL_ALLOWED_IPS=127.0.0.1,::1

# metrics 可信反向代理：逗号分隔的精确 IP 或 CIDR；同样要求非空、无空项且全部合法
# 仅 RemoteAddr 命中本列表时，应用才读取代理覆盖的单值 X-Real-IP；应用永不读取 X-Forwarded-For
# 反代必须删除 X-Forwarded-For/Forwarded 并覆盖而非追加 X-Real-IP
INTERNAL_TRUSTED_PROXY_IPS=127.0.0.1,::1

# ============================================================
# 第二阶段 Token 网关 / 工作台编排（S2，门面↔asset 内部调用、插件、计费兜底）

# AI 网关 G4 默认资源治理值；数据库 active 策略可按用户、Project、SK、模型覆盖。
# 所有值必须为正整数，Redis 不可用时 G4 失败关闭，不会退化为本机计数。
AI_GATEWAY_USER_CONCURRENCY=100
AI_GATEWAY_USER_RPM=600
AI_GATEWAY_USER_TPM=2000000
AI_GATEWAY_PROJECT_CONCURRENCY=100
AI_GATEWAY_PROJECT_RPM=600
AI_GATEWAY_PROJECT_TPM=2000000
AI_GATEWAY_KEY_CONCURRENCY=50
AI_GATEWAY_KEY_RPM=300
AI_GATEWAY_KEY_TPM=1000000
AI_GATEWAY_MODEL_CONCURRENCY=500
AI_GATEWAY_MODEL_RPM=3000
AI_GATEWAY_MODEL_TPM=10000000
# ============================================================
# 内部接口共享密钥：既用于门面 prepaid 调用，也用于 GET /api/internal/metrics 的 X-Internal-Token
# 原始 UTF-8 值不得含首尾空白且至少 32 字节；大小写不敏感拒绝空值及 REPLACE_WITH_INTERNAL_API_TOKEN、CHANGE_ME、CHANGEME、DEFAULT、SECRET、TEST
# 请求头按原始字节常量时间比较；生产/测试应由 CSPRNG 生成至少 32 个随机字节后编码为 base64 或 hex，并通过安全渠道注入
# 密钥不得写入仓库实际配置、应用/访问日志、审计、指标或前端配置；此处仅保留明确会被拒绝的示例占位
INTERNAL_API_TOKEN=REPLACE_WITH_INTERNAL_API_TOKEN

# 测试环境 Prometheus（只监听宿主机回环地址，不得暴露到公网）
# Prometheus 容器固定地址必须被 API 的 INTERNAL_ALLOWED_IPS 精确放行，但不得加入 INTERNAL_TRUSTED_PROXY_IPS
PROMETHEUS_CONTAINER_IP=172.31.250.10
# 专用监控网段不得与服务器现有 Docker/VPC 网段冲突
PROMETHEUS_SUBNET=172.31.250.0/24
# Prometheus 管理界面宿主机端口，Compose 固定绑定 127.0.0.1
PROMETHEUS_PORT=19090

# asset 模块内部接口基址，门面 prepaid 结算调用 entitlement-consume 用
# 同进程部署时指向本机 API 端口（默认本机回环）
ASSET_INTERNAL_BASE_URL=http://127.0.0.1:8080

# postpaid 预扣保证金兜底单价（每 token，单位 CNY）；仅用于前置冻结防并发透支，实扣以计费规则为准
# 取保守值，宁高勿低（高估只多冻结、结算时退回，绝不透支），默认约 ¥0.02/千 token
TOKEN_HOLD_UNIT_PRICE=0.00002

# postpaid 预扣保证金兜底 max_tokens；请求未带 max_tokens 时按此上限冻结
TOKEN_HOLD_DEFAULT_MAX_TOKENS=4096

# 工作台插件凭证（plugins.auth_config_encrypted）加密密钥（32 字节，AES-256-GCM）
# 未配置时回退复用 TOKEN_PROVIDER_KEY（契约允许）；生产/测试建议独立注入强随机值，不入库
PLUGIN_SECRET_KEY=REPLACE_WITH_32_BYTE_PLUGIN_SECRET_KEY

# tool-use 编排最大轮数（默认 5）
MAX_ROUNDS=5

# 工作台外呼（插件转发 / skill 联网）域名白名单（逗号分隔，如 api.weather.com,docs.example.com）
# 空=不启用白名单（仅按 SSRF 网段规则拦内网/回环）
PLUGIN_DOMAIN_WHITELIST=

# 自建可信环境开关：true 时放开对外访问链接的 http 协议与内网/IP 直连（MCP/插件/Skill/应用入口 access_url），
# 供无 https/无域名的局域网内部署使用。生产/公网环境务必保持 false（仅 https + 禁内网，防 SSRF）。
# 注意：危险 scheme（javascript:/data:）与实名附件校验不受此开关影响，始终拒绝/始终 https。
# 若同时配置了 PLUGIN_DOMAIN_WHITELIST，白名单优先级高于本开关（仍只放行白名单内主机）。
TRUST_INTERNAL_OUTBOUND=false

# ============================================================
# presenton 应用接入（反向代理 / BFF 嵌入，密钥禁止入库）
# 说明：以下为运维侧反向代理与嵌入配置；presenton 服务仅绑本机 127.0.0.1:5001
# ============================================================
# 反代内网 presenton 入口（必配，否则反代不注册）
PRESENTON_INTERNAL_BASE_URL=http://127.0.0.1:5001
# 拼前端嵌入 URL 的公网域名（按部署环境填写，如 http://your-host:8080）
PRESENTON_GATEWAY_BASE_URL=http://127.0.0.1:8080
# 反代公开前缀（默认值）
PRESENTON_PATH_PREFIX=/app/presenton
# 应用 code（需与 seed 一致）
PRESENTON_APP_CODE=presenton-ppt
# 票据有效期（秒）
PRESENTON_TICKET_TTL_SECONDS=300
# 会话有效期（秒）
PRESENTON_SESSION_TTL_SECONDS=7200
# BFF↔presenton 共享密钥，与 presenton 端 MOLIN_TRUST_SECRET 同一个值
# 生产/测试需注入真实强随机值（如 openssl rand -hex 32），不入库
MOLIN_TRUST_SECRET=REPLACE_WITH_MOLIN_TRUST_SECRET

# ============================================================
# 管理员引导（一次性 bootstrap CLI 使用，可选；执行后建议清空）
# ============================================================
# BOOTSTRAP_ADMIN_USERNAME=admin
# BOOTSTRAP_ADMIN_NICKNAME=超级管理员
# BOOTSTRAP_ADMIN_PHONE=
# BOOTSTRAP_ADMIN_EMAIL=
# BOOTSTRAP_ADMIN_PASSWORD_HASH=     # bcrypt 哈希值，禁止填明文密码，不入库
