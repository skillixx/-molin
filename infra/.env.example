# ============================================================
# Molin 云管理平台 — 环境变量模板
# 复制此文件为 .env.local 并填写实际值
# 禁止将含真实密钥的 .env.local / .env.prod 提交到代码仓库
# ============================================================

# 应用基础
APP_ENV=local                          # local / test / production
APP_NAME=molin-cloud-platform
API_HOST=0.0.0.0
API_PORT=8080

# MySQL
MYSQL_HOST=127.0.0.1
MYSQL_PORT=13306
MYSQL_DATABASE=molin
MYSQL_USER=molin
MYSQL_PASSWORD=molin_password          # 生产环境必须更换为强密码

# Redis
REDIS_ADDR=127.0.0.1:16379
REDIS_PASSWORD=                        # 本地可为空，生产必须设置密码
REDIS_DB=0

# RabbitMQ
RABBITMQ_URL=amqp://molin:molin_password@127.0.0.1:5673/

# MinIO
MINIO_ENDPOINT=127.0.0.1:19000
MINIO_ACCESS_KEY=molin
MINIO_SECRET_KEY=molin_password        # 生产环境必须更换
MINIO_BUCKET=molin
MINIO_USE_SSL=false                    # 生产环境改为 true

# JWT（必须使用随机生成的强密钥，不得使用示例值）
JWT_SECRET=REPLACE_WITH_RANDOM_SECRET_MIN_32_CHARS
JWT_EXPIRE_SECONDS=7200                # Access Token 有效期 2 小时

# Refresh Token（必须独立密钥，不得与 JWT_SECRET 相同）
REFRESH_TOKEN_SECRET=REPLACE_WITH_ANOTHER_RANDOM_SECRET
REFRESH_TOKEN_EXPIRE_DAYS=30

# 平台 sk（API Key）HMAC 存储密钥（与 REFRESH_TOKEN_SECRET 同级）
# DB 只存 HMAC-SHA256(sk, API_KEY_HMAC_SECRET)，不存明文；生产环境必须使用强随机值（如 openssl rand -hex 32）
# 注意：仅当此变量非空时后端才会装配 sk 系统（/api/keys 路由、sk 双模式鉴权）
API_KEY_HMAC_SECRET=REPLACE_WITH_API_KEY_HMAC_SECRET_MIN_32_CHARS

# 身份证号 HMAC（严禁使用 SHA256 直接 hash，必须使用 HMAC + 此密钥）
ID_CARD_HMAC_SECRET=REPLACE_WITH_HMAC_SECRET_MIN_32_CHARS

# 管理员双重认证有效期（小时），超时后需重新完成手机+邮箱认证，默认 24 小时
ADMIN_VERIFY_EXPIRE_HOURS=24

# Token 供应商密钥加密（第三阶段使用，AES-256-GCM 密钥必须 32 字节）
TOKEN_PROVIDER_KEY=REPLACE_WITH_32_BYTE_AES_KEY_FOR_PRODUCTION

# 支付回调（第三阶段使用）
WECHAT_PAY_MCH_ID=                    # 微信支付商户号
WECHAT_PAY_API_V3_KEY=               # 微信支付 APIv3 密钥
WECHAT_PAY_SERIAL_NO=                # 微信支付证书序列号
# 微信支付平台公钥（PEM 文本），用于支付回调验签；生产/测试需注入真实值，不入库
WECHAT_PLATFORM_PUBLIC_KEY=
ALIPAY_APP_ID=                        # 支付宝 APPID
ALIPAY_PRIVATE_KEY=                   # 支付宝应用私钥
ALIPAY_PUBLIC_KEY=                    # 支付宝公钥

# 支付回调报文 AES-256-GCM 加密密钥（32 字节原始字符串），用于 payment_callbacks.notify_body
# 生产/测试需注入真实 32 字节随机值（如 openssl rand -hex 16），不入库
NOTIFY_BODY_KEY=REPLACE_WITH_32_BYTE_NOTIFY_BODY_KEY

# 短信服务（按实际服务商填写）
SMS_PROVIDER=                         # aliyun / tencent
SMS_ACCESS_KEY=
SMS_ACCESS_SECRET=
SMS_SIGN_NAME=
SMS_TEMPLATE_CODE_REGISTER=
SMS_TEMPLATE_CODE_LOGIN=

# 邮件服务
SMTP_HOST=
SMTP_PORT=465
SMTP_USER=
SMTP_PASSWORD=
SMTP_FROM=noreply@example.com

# 内部上报接口 IP 白名单（逗号分隔），用于内部数据上报接口源 IP 鉴别
# 注意：经边缘 NAT 后源 IP 可能被改写为本机回环，需配合可信代理 XFF 解析
INTERNAL_ALLOWED_IPS=127.0.0.1,::1

# ============================================================
# 第二阶段 Token 网关 / 工作台编排（S2，门面↔asset 内部调用、插件、计费兜底）
# ============================================================
# 内部接口共享密钥：门面 prepaid 结算调用 asset entitlement-consume 时带 X-Internal-Token=该值
# 与 asset / finance_consumer 校验侧同源；未配置时 prepaid 内部调用 fail-closed
# 生产/测试需注入强随机值（如 openssl rand -hex 32），不入库
INTERNAL_API_TOKEN=REPLACE_WITH_INTERNAL_API_TOKEN

# asset 模块内部接口基址，门面 prepaid 结算调用 entitlement-consume 用
# 同进程部署时指向本机 API 端口（默认本机回环）
ASSET_INTERNAL_BASE_URL=http://127.0.0.1:8080

# postpaid 预扣保证金兜底单价（每 token，单位 CNY）；仅用于前置冻结防并发透支，实扣以计费规则为准
# 取保守值，宁高勿低（高估只多冻结、结算时退回，绝不透支），默认约 ¥0.02/千 token
TOKEN_HOLD_UNIT_PRICE=0.00002

# postpaid 预扣保证金兜底 max_tokens；请求未带 max_tokens 时按此上限冻结
TOKEN_HOLD_DEFAULT_MAX_TOKENS=4096

# 工作台插件凭证（plugins.auth_config_encrypted）加密密钥（32 字节，AES-256-GCM）
# 未配置时回退复用 TOKEN_PROVIDER_KEY（契约允许）；生产/测试建议独立注入强随机值，不入库
PLUGIN_SECRET_KEY=REPLACE_WITH_32_BYTE_PLUGIN_SECRET_KEY

# tool-use 编排最大轮数（默认 5）
MAX_ROUNDS=5

# 工作台外呼（插件转发 / skill 联网）域名白名单（逗号分隔，如 api.weather.com,docs.example.com）
# 空=不启用白名单（仅按 SSRF 网段规则拦内网/回环）
PLUGIN_DOMAIN_WHITELIST=

# ============================================================
# presenton 应用接入（反向代理 / BFF 嵌入，密钥禁止入库）
# 说明：以下为运维侧反向代理与嵌入配置；presenton 服务仅绑本机 127.0.0.1:5001
# ============================================================
# 反代内网 presenton 入口（必配，否则反代不注册）
PRESENTON_INTERNAL_BASE_URL=http://127.0.0.1:5001
# 拼前端嵌入 URL 的公网域名（按部署环境填写，如 http://your-host:8080）
PRESENTON_GATEWAY_BASE_URL=http://127.0.0.1:8080
# 反代公开前缀（默认值）
PRESENTON_PATH_PREFIX=/app/presenton
# 应用 code（需与 seed 一致）
PRESENTON_APP_CODE=presenton-ppt
# 票据有效期（秒）
PRESENTON_TICKET_TTL_SECONDS=300
# 会话有效期（秒）
PRESENTON_SESSION_TTL_SECONDS=7200
# BFF↔presenton 共享密钥，与 presenton 端 MOLIN_TRUST_SECRET 同一个值
# 生产/测试需注入真实强随机值（如 openssl rand -hex 32），不入库
MOLIN_TRUST_SECRET=REPLACE_WITH_MOLIN_TRUST_SECRET

# ============================================================
# 管理员引导（一次性 bootstrap CLI 使用，可选；执行后建议清空）
# ============================================================
# BOOTSTRAP_ADMIN_USERNAME=admin
# BOOTSTRAP_ADMIN_NICKNAME=超级管理员
# BOOTSTRAP_ADMIN_PHONE=
# BOOTSTRAP_ADMIN_EMAIL=
# BOOTSTRAP_ADMIN_PASSWORD_HASH=     # bcrypt 哈希值，禁止填明文密码，不入库
