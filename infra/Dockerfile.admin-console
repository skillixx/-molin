# 管理后台生产镜像
# 构建命令：docker build -f infra/Dockerfile.admin-console -t molin-admin .

FROM node:20-alpine AS builder

WORKDIR /build
COPY web/shared/ ../shared/
COPY web/admin-console/package*.json ./
RUN npm ci
COPY web/admin-console/ .
RUN npm run build

FROM nginx:alpine
COPY --from=builder /build/dist /usr/share/nginx/html
COPY infra/nginx/admin.conf /etc/nginx/conf.d/default.conf
EXPOSE 80
