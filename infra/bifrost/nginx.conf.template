worker_processes auto;

events {
    worker_connections 4096;
}

http {
    access_log off;
    error_log /dev/stderr warn;
    map_hash_bucket_size 128;

    map $http_authorization $bifrost_internal_authorized {
        default 0;
        "Bearer ${BIFROST_INTERNAL_TOKEN}" 1;
    }

    upstream bifrost_nodes {
        least_conn;
        server bifrost-1:8080 max_fails=3 fail_timeout=10s;
        server bifrost-2:8080 max_fails=3 fail_timeout=10s;
        keepalive 128;
    }

    server {
        listen 8080;

        # 健康检查只在宿主机回环地址使用，不代理模型调用权限。
        location = /health {
            proxy_pass http://bifrost_nodes;
        }

        # 只经 LB 暴露逐节点健康状态，监控无需加入节点网络或获得模型调用能力。
        location = /health/bifrost-1 {
            proxy_pass http://bifrost-1:8080/health;
        }

        location = /health/bifrost-2 {
            proxy_pass http://bifrost-2:8080/health;
        }

        location / {
            if ($bifrost_internal_authorized = 0) {
                return 401;
            }

            proxy_pass http://bifrost_nodes;
            proxy_http_version 1.1;
            proxy_set_header Connection "";
            proxy_buffering off;
            proxy_cache off;
            proxy_read_timeout 900s;
            proxy_send_timeout 900s;

            # 内部入口完成校验后清除 Token，禁止 Bifrost 或上游误用该凭据。
            proxy_set_header Authorization "";
            proxy_set_header Host $host;
            proxy_set_header X-Request-ID $http_x_request_id;
            add_header X-Accel-Buffering no;
        }
    }
}
