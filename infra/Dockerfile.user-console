# 用户控制台生产镜像
# 构建命令：docker build -f infra/Dockerfile.user-console -t molin-user .

FROM node:24-alpine AS builder

WORKDIR /build
COPY web/shared/ ../shared/
COPY web/user-console/package*.json ./
RUN npm ci
COPY web/user-console/ .
RUN npm run build

FROM nginx:alpine
COPY --from=builder /build/dist /usr/share/nginx/html
COPY infra/nginx/user.conf /etc/nginx/conf.d/default.conf
EXPOSE 80
