      "gridPos": {"h": 6, "w": 8, "x": 16, "y": 8}
    },
    {
      "type": "stat",
      "title": "运行组件健康",
      "targets": [
        {"expr": "molin_ai_gateway_video_component_up", "legendFormat": "{{component}} up"},
        {"expr": "molin_ai_gateway_video_component_last_success_age_seconds", "legendFormat": "{{component}} 最近成功秒数"}
      ],
      "gridPos": {"h": 6, "w": 8, "x": 0, "y": 14}
