{
  "Version": "2012-10-17",
  "Statement": [
    {
      "Effect": "Allow",
      "Action": ["s3:ListBucket", "s3:GetBucketLocation"],
      "Resource": [
        "arn:aws:s3:::ai-upload-temp",
        "arn:aws:s3:::ai-result",
        "arn:aws:s3:::ai-quarantine"
      ]
    },
    {
      "Effect": "Allow",
      "Action": ["s3:GetObject", "s3:PutObject", "s3:DeleteObject"],
      "Resource": [
        "arn:aws:s3:::ai-upload-temp/*",
        "arn:aws:s3:::ai-result/*",
        "arn:aws:s3:::ai-quarantine/*"
      ]
    }
  ]
}
